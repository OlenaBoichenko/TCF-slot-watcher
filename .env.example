# --- Telegram (main notification channel) ---
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot 
# 3. Run get_chat_id.py, or open https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy push (optional, mirrors Telegram) ---
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Web UI access ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Other ---
# Defaults to ./data/slots.db locally; Docker sets /data/slots.db.
# DB_PATH=
TICK_SECONDS=15
REQUEST_TIMEOUT=30
PUBLIC_URL=
# Time zone for registration opening times in messages.
TIMEZONE=
